APP_NAME=Fraud Detection Analyst Hub Backend
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# PostgreSQL or SQLite URL:
# For PostgreSQL: postgresql+psycopg://postgres:password@localhost:5432/fraud_detection
DATABASE_URL=sqlite:///fraud_detection.db

RISK_ENGINE=dummy
RISK_MODEL_VERSION=1.0

# Threshold Configuration (Probability cutoffs)
DEFAULT_LOW_THRESHOLD=0.23
DEFAULT_HIGH_THRESHOLD=0.60
DEFAULT_CRITICAL_THRESHOLD=0.80

# Storage Directories
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
REPORT_DIR=reports

# Kaggle Integration & Automated Retraining
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_SLUG=healthcare-provider-fraud-dataset
KAGGLE_KERNEL_SLUG=fraud-detection-xgboost-training
AUTO_RETRAIN_AFTER_TRAINING_EXPORT=false

FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
MAX_CONTENT_LENGTH=104857600