# -------------------------------------------------------
# Healthcare Fraud-Risk Detection API — Environment Config
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Model version to load (must match a subdirectory under models/)
ACTIVE_MODEL_VERSION=v1

# Binary fraud classification threshold (locked from training)
FRAUD_THRESHOLD=0.23

# Risk banding thresholds (for triage/prioritisation only)
# probability < RISK_LOW_MAX             → LOW  / NOT_FLAGGED
# RISK_LOW_MAX <= probability < RISK_MEDIUM_MAX → MEDIUM / FLAGGED_FOR_REVIEW
# probability >= RISK_MEDIUM_MAX         → HIGH / FLAGGED
RISK_LOW_MAX=0.23
RISK_MEDIUM_MAX=0.60

# Maximum allowed CSV upload size in megabytes
MAX_UPLOAD_MB=50

# Server port (7860 is the Hugging Face Spaces default)
PORT=7860

# Set to 1 for development hot-reload (never use in production)
FLASK_DEBUG=0

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
